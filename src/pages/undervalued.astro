---
import Base from '../layouts/Base.astro';
import screen from '../../data/screen.json';

const d = screen;
const rf = d.meta.riskFree.value;
const b = d.breadth;

const pctColor = (p: number) => (p <= 15 ? 'var(--cheap)' : p <= 35 ? 'var(--fair)' : p <= 65 ? 'var(--muted)' : 'var(--expensive)');
const priorityLabel: Record<string, { text: string; cls: string }> = {
  high: { text: '先做这个', cls: 'cheap' },
  medium: { text: '可排期', cls: 'fair' },
  low: { text: '暂不做', cls: 'unknown' },
};
---

<Base
  title="低估值扫描"
  subtitle="回答一个问题：A 股现在到底有没有便宜货。答案是有的，而且在特定角落很密集——但那些角落恰好是三层过滤器测不准的地方。"
>
  <h1>低估值扫描</h1>

  <div class="notice info">
    <strong>这一页的存在理由</strong>：2026-11 复核个股池时发现，六只全部「需观察」，很容易被读成「A 股没有便宜货」。
    真实情况相反——市场里 501 只股票跌破净资产，银行 42 只全部破净，主板 PB 已在十年 14% 分位。
    问题不是市场没有便宜，是<strong>我的个股框架对这批板块恰好失效</strong>。所以把它单列，而不是假装不存在。
  </div>

  <div class="grid grid-3" style="margin-top:16px">
    <div class="card">
      <div class="kv">
        <span class="k">破净股数量 / 占比</span>
        <span class="v" style="color:var(--cheap)">{b.belowBook} 只 · {b.belowBookPct}%</span>
        <span class="sub">全 A {b.total} 只中 PB 有效的 {b.pbValid} 只</span>
      </div>
    </div>
    <div class="card">
      <div class="kv">
        <span class="k">破净股占全市场市值</span>
        <span class="v">{b.belowBookMcapSharePct}%</span>
        <span class="sub">不是小众现象——它们合计 {b.belowBookMcapSharePct}% 的市值</span>
      </div>
    </div>
    <div class="card">
      <div class="kv">
        <span class="k">破净股股息率中位</span>
        <span class="v" style="color:var(--cheap)">{b.medianDyBelowBook}%</span>
        <span class="sub">全样本 {b.medianDyAll}%，是它的 {(b.medianDyBelowBook / b.medianDyAll).toFixed(1)} 倍｜对 {rf}% 国债利差 {(b.medianDyBelowBook - rf).toFixed(2)}pct</span>
      </div>
    </div>
  </div>

  <div class="section-head">
    <h2>市场是分层的，不是整体贵或整体便宜</h2>
    <span class="hint">同一时点，主板 PB 十年 14% 分位，科创板 PE 五年 72% 分位</span>
  </div>
  <div class="card" style="overflow-x:auto">
    <table>
      <thead>
        <tr>
          <th>分层</th>
          <th class="num">标的数</th>
          <th class="num">PE</th>
          <th class="num">PE 分位 3y / 5y / 10y</th>
          <th class="num">PB</th>
          <th class="num">PB 分位 3y / 5y / 10y</th>
        </tr>
      </thead>
      <tbody>
        {d.indices.map((i) => (
          <tr>
            <td>
              <strong>{i.name}</strong>
              <div class="small dim" style="margin-top:2px;max-width:30ch">{i.note}</div>
            </td>
            <td class="num mono">{i.count}</td>
            <td class="num mono">{i.pe.toFixed(2)}</td>
            <td class="num mono small">
              <span style={`color:${pctColor(i.pePct.y3)}`}>{i.pePct.y3}</span>
              <span class="dim"> / </span>
              <span style={`color:${pctColor(i.pePct.y5)}`}>{i.pePct.y5}</span>
              <span class="dim"> / </span>
              <span style={`color:${pctColor(i.pePct.y10)}`}>{i.pePct.y10}</span>
            </td>
            <td class="num mono">{i.pb.toFixed(2)}</td>
            <td class="num mono small">
              <span style={`color:${pctColor(i.pbPct.y3)}`}>{i.pbPct.y3}</span>
              <span class="dim"> / </span>
              <span style={`color:${pctColor(i.pbPct.y5)}`}>{i.pbPct.y5}</span>
              <span class="dim"> / </span>
              <span style={`color:${pctColor(i.pbPct.y10)}`}>{i.pbPct.y10}</span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="small dim" style="margin:14px 0 0">
      分位用法：PE 与 PB 要分开看。创业板 PE 十年 64% 分位、PB 只有 19% 分位，两者背离说明盈利被摊薄（分母变大），
      不是估值便宜。各层标的数口径不同，不构成加总关系。
    </p>
  </div>

  <div class="section-head">
    <h2>破净集中在哪：重资产与高杠杆</h2>
    <span class="hint">五个行业占了破净总数的近三成</span>
  </div>
  <div class="card" style="overflow-x:auto">
    <table>
      <thead>
        <tr><th>行业</th><th class="num">破净率</th><th class="num">破净只数</th><th>备注</th></tr>
      </thead>
      <tbody>
        {d.sectorBreakdown.map((s) => (
          <tr>
            <td><strong>{s.name}</strong></td>
            <td class="num mono" style={`color:${s.belowBookPct >= 40 ? 'var(--cheap)' : s.belowBookPct <= 1 ? 'var(--expensive)' : 'var(--muted)'};font-weight:600`}>
              {s.belowBookPct}%
            </td>
            <td class="num mono">{s.count ?? '—'}</td>
            <td class="small muted">{s.detail}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="small dim" style="margin:14px 0 0">
      电子 521 只中只有 3 只破净、计算机 353 只中只有 1 只——同一市场里两个极端同时存在。
      这就是「整体估值」这个指标没用的原因。
    </p>
  </div>

  <div class="section-head">
    <h2>破净股内部的两条分界线</h2>
    <span class="hint">便宜和有安全边际，是两件事</span>
  </div>
  <div class="grid grid-2">
    <div class="card">
      <div class="kv">
        <span class="k">分界线一：分红能力</span>
        <span class="v" style="color:var(--cheap)">{b.belowBookDyAbove3} 只</span>
        <span class="sub">破净且股息率高于 3%——这才是真正的「有现金流支撑的便宜」</span>
      </div>
    </div>
    <div class="card">
      <div class="kv">
        <span class="k">分界线二：是否还在赚钱</span>
        <span class="v" style="color:var(--expensive)">{b.belowBookLoss} 只（{b.belowBookLossPct}%）</span>
        <span class="sub">破净的同时处于亏损——折价有其原因，缺分红能力</span>
      </div>
    </div>
  </div>
  <div class="notice" style="margin-top:14px">
    <strong>这两条线的意思</strong>：501 只破净股里，{b.belowBookDyAbove3} 只股息率超过 3%，
    同时 {b.belowBookLoss} 只在亏损（{b.belowBookLossPct}%）。两个数字都要看：只挑「破净 + 高股息」会踩到亏损股，
    只挑「破净 + 盈利」又会忽略分红能力。真正值得进入个股池的样本量级大概是几十只，不是 501 只。
  </div>

  <div class="section-head">
    <h2>一个反直觉的事实：市值越大，破净率越高</h2>
    <span class="hint">「小盘更容易破净」是错的</span>
  </div>
  <div class="card">
    <table>
      <thead><tr><th>市值区间</th><th class="num">破净率</th><th style="width:55%">分布</th></tr></thead>
      <tbody>
        {d.mcapBuckets.map((m) => (
          <tr>
            <td class="mono">{m.label}</td>
            <td class="num mono" style="font-weight:600">{m.belowBookPct}%</td>
            <td>
              <div style="height:8px;background:rgba(255,255,255,.06);border-radius:4px;overflow:hidden">
                <div style={`height:100%;width:${(m.belowBookPct / 21.6) * 100}%;background:${m.belowBookPct >= 20 ? 'var(--cheap)' : 'rgba(110,168,254,.55)'};border-radius:4px`}></div>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="small dim" style="margin:14px 0 0">
      1000 亿以上 21.6%，100 亿以下 7.6%。原因是破净集中在银行、地产、钢铁、煤炭这些重资产行业，
      而它们恰好是大市值——不是「大公司出了问题」，是「重资产行业在这轮定价里被系统性折价」。
    </p>
  </div>

  <div class="section-head">
    <h2>为什么这块没进个股池：三层过滤器在这里测不准</h2>
    <span class="hint">不是不想覆盖，是拿错尺子会得出错误结论</span>
  </div>
  <div class="card" style="padding:0;overflow:hidden">
    {d.blindspots.map((z) => {
      const p = priorityLabel[z.priority] ?? priorityLabel.medium;
      return (
        <div style="padding:16px 18px;border-bottom:1px solid var(--line)">
          <div style="display:flex;gap:10px;align-items:center;margin-bottom:8px">
            <strong style="font-size:14.5px">{z.sector}</strong>
            <span class={`badge ${p.cls}`} style="font-size:10px">{p.text}</span>
          </div>
          <div class="small muted" style="line-height:1.7;margin-bottom:8px">
            <strong style="color:var(--expensive)">为什么测不准：</strong>{z.why}
          </div>
          <div class="small" style="line-height:1.7;color:var(--accent)">
            <strong>正确的尺子：</strong>{z.rightRuler}
          </div>
        </div>
      );
    })}
  </div>

  <div class="notice info" style="margin-top:20px">
    <strong>结论，一句话</strong>：A 股现在有便宜货，而且密度不低——但它们集中在「重资产、高杠杆、被长期嫌弃」的角落，
    而这些角落需要的估值工具与消费股、成长股完全不同。面板缺的不是标的，是这几把尺子。按上面的优先级，
    银行（PB−ROE + 不良生成率）最该先补，煤炭钢铁（股息率对价格的敏感性）次之，地产暂不做。
  </div>
</Base>
