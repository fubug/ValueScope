---
import Base from '../layouts/Base.astro';
import PercentileBar from '../components/PercentileBar.astro';
import marketsData from '../../data/markets.json';
import {
  judge,
  pickPrimaryPercentile,
  marketSortKey,
  absolutePositions,
  positionHint,
  CONFIDENCE_LABEL,
  INTEGRITY_LABEL,
  type MarketsFile,
} from '../lib/rules';

const data = marketsData as unknown as MarketsFile;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const rows = data.markets
  .map((m) => {
    const v = judge(m);
    const p = pickPrimaryPercentile(m);
    return { m, v, p };
  })
  /* 排序按 [档位, 指标类型, 可比性, 数值]——不能直接拿 CAPE 96 和 PE 49 比大小，
     那等于宣称「美国比日本贵一倍」，而两个指标的分位分布根本不同。 */
  .sort((a, b) => {
    const x = marketSortKey(a.v);
    const y = marketSortKey(b.v);
    for (let i = 0; i < x.length; i++) if (x[i] !== y[i]) return x[i] - y[i];
    return 0;
  });

/* 横向：当期估值的跨市场排名。与「分位」这个纵向尺度互补，
   让没有分位序列的市场（英/德/越/韩）也能看到自己的位置。 */
const positions = absolutePositions(data.markets);
const posMetrics = ['pe', 'pb', 'cape', 'peForward', 'dividendYield'] as const;
const posOrder = [...data.markets].sort(
  (a, b) => (a.valuation.peTtm ?? 999) - (b.valuation.peTtm ?? 999)
);

const unknown = rows.filter((r) => r.v.tier === 'unknown').length;
const missingLongRun = data.markets.filter((m) => m.longRun.cagr10y == null).length;
const notComparable = rows.filter((r) => !r.v.comparable).length;
const withPercentile = rows.filter((r) => r.p).length;

const fmt = (v: number | null | undefined, digits = 1) =>
  v == null ? '—' : v.toFixed(digits);
---
<Base title="全球主要市场" subtitle="买的是宽基指数，所以只看三件事：贵不贵（分位）、赚不赚钱（长期年化与夏普）、值不值得现在买（性价比）。">
  <h1>全球主要市场</h1>

  <div class="notice">
    <strong>数据快照 {data.meta.snapshot}</strong>，全部为手工核对的公开数据，非实时行情。{unknown > 0 && `其中 ${unknown} 个市场缺少可用估值数据，未做档位判断。`}
    分位数字越高越贵，判定规则见<a href={`${base}/method/`} style="color:inherit;text-decoration:underline">方法论</a>。
  </div>

  <div class="notice">
    <strong>为什么「美股很贵」和「纳斯达克 100 偏便宜」可以同时出现。</strong>
    这不是矛盾，是两个窗口在说不同的话：ETF 面板里的纳指用的是 <span class="mono">PE 27.08 / 近 10 年分位 28</span>——
    相对过去十年，现在确实比大多数时候便宜；而这里的美股用的是 <span class="mono">CAPE 40.71 / 近 45 年分位 96.3</span>——
    相对过去四十五年，现在几乎是最贵。
    两个数字都对，差别在「拿哪一段历史当锚」。所以本面板的每一格分位都标注了自己的窗口长度，
    跨指标、跨窗口的「谁更贵」不再排名——<strong>分位不说窗口，等于没说。</strong>
  </div>

  <div class="grid grid-2" style="margin-top:24px">
    <div class="card">
      <h3>美国：三个口径，三种「贵」</h3>
      <p class="small muted" style="margin-bottom:10px">
        CAPE 40.71 是 1881 年以来第 19 高，只有 1999-03 至 2000-09 的 18 个月份更高。
      </p>
      <div class="stat-row">
        <div class="kv"><span class="k">CAPE 45 年分位</span><span class="v" style="color:var(--expensive)">96.3</span></div>
        <div class="kv"><span class="k">TTM PE</span><span class="v">23.9</span></div>
        <div class="kv"><span class="k">前向 PE</span><span class="v">18.7</span></div>
      </div>
      <p class="small dim" style="margin-top:10px;margin-bottom:0">
        前向 PE 18.7 已低于历史均值 19.06——但这个「便宜」是分子跌掉 5%、分母（盈利预期）还在涨来的，
        而盈利预期的依托正是市场最担心的 AI 资本开支。10Y 美债 4.93%，ERP −2.47% 仍为负。
      </p>
    </div>

    <div class="card">
      <h3>韩国：账面便宜到极端，但那不是同一个分母</h3>
      <p class="small muted" style="margin-bottom:10px">
        10 月 −16.2%、11 月首周 −11.7%，11-06 单日 −8% 触发熔断；11-09 勉强守住 5,000。
      </p>
      <div class="stat-row">
        <div class="kv"><span class="k">前向 PER</span><span class="v" style="color:var(--cheap)">3.54</span></div>
        <div class="kv"><span class="k">前向 PBR</span><span class="v" style="color:var(--cheap)">0.95</span></div>
        <div class="kv"><span class="k">10 月跌幅</span><span class="v" style="color:var(--expensive)">−16.2%</span></div>
      </div>
      <p class="small dim" style="margin-top:10px;margin-bottom:0">
        3.54 倍是 2001 年以来最低，但它算的是 2027 年预期盈利——SK 海力士 2027 营业利润被预测到 443.8 万亿韩元（+56%）。
        <strong>便宜与否取决于一个和砸盘同源的变量</strong>，所以本面板给的是「数据不足」而不是「极具性价比」。
      </p>
    </div>

    <div class="card">
      <h3>中国：便宜的是资产，不是利润</h3>
      <p class="small muted" style="margin-bottom:10px">
        沪深300 PE 十年 68 分位，PB 十年 21 分位——差 47 个百分点，是本次调研最大的指标背离。
      </p>
      <div class="stat-row">
        <div class="kv"><span class="k">PE 分位</span><span class="v" style="color:var(--expensive)">68</span></div>
        <div class="kv"><span class="k">PB 分位</span><span class="v" style="color:var(--cheap)">21</span></div>
        <div class="kv"><span class="k">股息率</span><span class="v">3.14%</span></div>
      </div>
      <p class="small dim" style="margin-top:10px;margin-bottom:0">
        PE 高是因为盈利在周期底部（三季报净利 +8%、9 月 PPI +5.0% 已在修复），不是估值高。
        买 PE 高分位是赌盈利修复，买 PB 低分位是买资产——两个不同的赌注。
      </p>
    </div>

    <div class="card">
      <h3>越南：分子分母同时有利，但指数在骗人</h3>
      <p class="small muted" style="margin-bottom:10px">
        TTM PE 10.97，剔除 Vingroup 系后仅 9.1；存款利率已从 5.97% 降到 5.55%。
      </p>
      <div class="stat-row">
        <div class="kv"><span class="k">TTM PE</span><span class="v">10.97</span></div>
        <div class="kv"><span class="k">剔除 Vingroup</span><span class="v">9.1</span></div>
        <div class="kv"><span class="k">存款利率</span><span class="v">5.55%</span></div>
      </div>
      <p class="small dim" style="margin-top:10px;margin-bottom:0">
        <strong>本次调研更正了此前的一处错误</strong>：面板原记「存款利率约 9%」，实为 5.55%。
        9% 会让越南的性价比结论完全反转。但 Vingroup 占市值 29%，买指数等于被动重仓一个房地产集团。
      </p>
    </div>
  </div>

  <div class="section-head">
    <h2>横向对比</h2>
    <span class="hint">先按档位、再按指标口径分组——不同指标的分位不在同一把尺上</span>
  </div>

  <div class="card" style="padding:18px 20px 6px;overflow-x:auto">
    <table>
      <thead>
        <tr>
          <th>市场 / 指数</th>
          <th class="num">PE</th>
          <th class="num">PB</th>
          <th class="num">股息率</th>
          <th style="min-width:190px">估值分位（窗口）</th>
          <th class="num">ERP</th>
          <th>判定</th>
        </tr>
      </thead>
      <tbody>
        {rows.map(({ m, v, p }) => (
          <tr>
            <td>
              <a href={`${base}/markets/${m.id}/`} style="font-weight:550">
                <span style="opacity:.85">{m.flag}</span> {m.name}
              </a>
              <div class="small dim mono">{m.indexName}</div>
            </td>
            <td class="num">{fmt(m.valuation.peTtm, 2)}</td>
            <td class="num">{fmt(m.valuation.pb, 2)}</td>
            <td class="num">{m.valuation.dividendYield == null ? '—' : `${fmt(m.valuation.dividendYield, 2)}%`}</td>
            <td>
              <PercentileBar value={p?.value ?? null} label={p?.basis} />
              {p && (
                <div class="small dim mono" style="margin-top:-2px">
                  {p.kind.toUpperCase()} · {p.windowLabel}{p.approx ? '（推断）' : ''}
                </div>
              )}
              {!p && <div class="small dim">{m.percentiles?.note ? '见详情页' : '缺数据'}</div>}
            </td>
            <td class="num" style={m.rates.erp != null && m.rates.erp < 0 ? 'color:var(--expensive)' : ''}>
              {m.rates.erp == null ? '—' : `${fmt(m.rates.erp, 2)}%`}
            </td>
            <td>
              <span class={`badge ${v.className}`}>{v.label}</span>
              {v.integrity !== 'clean' && (
                <div class="small dim" style="margin-top:4px;color:var(--fair)">{INTEGRITY_LABEL[v.integrity]}</div>
              )}
              {m.confidence !== 'high' && (
                <div class="small dim" style="margin-top:2px">{CONFIDENCE_LABEL[m.confidence]}</div>
              )}
              {m.analystView && (
                <div class="small dim" style="margin-top:2px">观点：{m.analystView.stance}</div>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {notComparable > 0 && (
    <p class="small dim" style="margin-top:10px">
      其中 {notComparable} 个市场的主分位不是 PE，或缺 PB 现值——它们的<strong>档位可信</strong>，但不能和别的市场直接比大小。
      比如美国用的是 CAPE（十年通胀调整盈利），它的 96 分位和日本的 PE 49 分位不是同一把尺子；
      把两者排在同一列里看「谁更贵」，是拿两个刻度不同的表去量同一个长度。
    </p>
  )}

  <div class="section-head">
    <h2>绝对估值横向定位</h2>
    <span class="hint">纵向分位答不了的问题，用横向排名答——但这是两把尺，不能合成一个分数</span>
  </div>

  <div class="notice">
    <strong>为什么要单独做这一块。</strong>
    本次调研发现长期分位的可得性极不均匀：{rows.length} 个市场里只有 {withPercentile} 个拿得到可信的长期分位序列，
    英、德、越、韩 只有当期估值、没有历史序列，于是只能判「数据不足」。
    但「没有分位」不等于「没有信息」——<span class="mono">PE 14.86</span> 与 <span class="mono">18.82</span> 谁高谁低是客观事实。
    下面这张表只做<strong>事实陈述</strong>（在 {rows.length} 个市场里排第几），不含判断：
    PE 低既可能是便宜，也可能是结构性折价——富时 100 的科技权重只有约 1%，它便宜是因为它是旧经济。
  </div>

  <div class="card" style="padding:18px 20px 6px;overflow-x:auto">
    <table>
      <thead>
        <tr>
          <th>市场</th>
          {posMetrics.map((k) => (
            <th class="num">{k === 'pe' ? 'PE 排名' : k === 'pb' ? 'PB 排名' : k === 'cape' ? 'CAPE 排名' : k === 'peForward' ? '前向 PE 排名' : '股息率排名'}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {posOrder.map((m) => {
          const ps = positions.get(m.id) ?? [];
          return (
            <tr>
              <td>
                <a href={`${base}/markets/${m.id}/`} style="font-weight:550">{m.name}</a>
                <div class="small dim mono">{m.indexName}</div>
              </td>
              {posMetrics.map((k) => {
                const p = ps.find((x) => x.metric === k);
                if (!p) return <td class="num dim">—</td>;
                const cheap = p.rank / p.total <= 0.5;
                return (
                  <td class="num">
                    <span class="mono">{p.value.toFixed(p.metric === 'dividendYield' ? 2 : 1)}</span>
                    <div class="small" style={cheap ? 'color:var(--cheap)' : 'color:var(--muted)'}>
                      {positionHint(p)}
                    </div>
                  </td>
                );
              })}
            </tr>
          );
        })}
      </tbody>
    </table>
    <p class="small dim" style="margin:0 0 4px">
      排名口径：PE / PB / CAPE / 前向 PE 越低越便宜，股息率越高越便宜。分母随指标变化（缺该项的市场不参与该列排名），
      所以「第 3」要看分母——某列只有 5 个有效值时，第 3 是中间，不是「第三便宜」。
      这不是分位，不能替代分位：分位回答「相对自己的历史」，这里回答「相对其它市场」。
    </p>
  </div>

  <div class="notice info" style="margin-top:20px">
    <strong>三个已知缺口</strong>，不填数字也不假装有：
    ① <strong>{missingLongRun} 个市场的长期年化收益与夏普比率全部未接入</strong>——沙箱内可用的历史行情接口（stooq / Yahoo / 东方财富）均被限流或需浏览器渲染，拿不到干净的长序列。这一列是「长期赚不赚钱」的核心，比估值分位更重要；补数据的方式是把月度或年度收盘价放进 <span class="mono">data/series/</span>，由脚本自己算，比抄第三方更可信。
    ② <strong>{rows.length - withPercentile} 个市场（英/德/越/韩）没有长期分位序列</strong>，只有当期估值，因此判「数据不足」。不是没查——是这类数据要么收费（Bloomberg/Wind 的历史 PE 序列）、要么需登录，公开源只给当期值。
    ③ <strong>STOXX 600 仍未收录</strong>：本次拿到英（14.86）、法（16.50）、德（18.82）三国的万得同源读数，但没有 STOXX 600 的可靠 PE/PB，故按国家分列而不混成一个「欧洲」——三国估值差 27%，合并会失真。
  </div>
</Base>
