---
import Base from '../../layouts/Base.astro';
import etfsData from '../../../data/etfs.json';
import {
  etfVerdict,
  toolRanking,
  entryAssessment,
  impliedPayoutRatio,
  indexValuation,
  pbPercentile,
  PAYOUT_CEILING,
  peSourceConflict,
  percentileWindowConflict,
  percentileReliability,
  premiumInFeeYears,
  premiumLimit,
  isQdii,
  SUBSCRIPTION_LABEL,
  ACTION_LABEL,
  ACTION_HINT,
  ACTION_TONE,
  TOOL_LABEL,
  ENTRY_LABEL,
  ETF_TURNOVER_MIN,
  type EtfsFile,
  type Etf,
  type EtfIndex,
  type EntryGrade,
} from '../../lib/rules';

export function getStaticPaths() {
  return (etfsData as unknown as EtfsFile).etfs.map((e) => ({
    params: { code: e.code },
    props: { e },
  }));
}

const data = etfsData as unknown as EtfsFile;
const { e } = Astro.props as { e: Etf };
const idx: EtfIndex | undefined = data.indices.find((i) => i.id === e.indexId);
const base = import.meta.env.BASE_URL.replace(/^\/$/, '').replace(/\/$/, '');
const snapshot = data.meta.snapshot;

const v = etfVerdict(e, idx, data.etfs, snapshot);
const tool = v.tool;
const entry = v.entry;
const feeYears = premiumInFeeYears(e);
const val = indexValuation(idx);
const pbOnly = val?.kind === 'pb';
const wc = percentileWindowConflict(idx);
const psc = peSourceConflict(idx);
const payout = impliedPayoutRatio(idx);
const payoutHigh = payout != null && payout > PAYOUT_CEILING;

/* 同指数对比：这一块是「买哪只」的全部依据，不能只看自己一只 */
const peers = data.etfs.filter((p) => p.indexId === e.indexId);
const ranked = toolRanking(e, peers, snapshot).map((p, i) => ({
  etf: p,
  rank: i + 1,
  verdict: etfVerdict(p, idx, data.etfs, snapshot),
}));

const ENTRY_TONE: Record<EntryGrade, string> = {
  cheap: 'cheap',
  fair: 'fair',
  expensive: 'expensive',
  unclear: 'unknown',
};

const pctColor = (x: number) =>
  x <= 15 ? 'var(--cheap)' : x <= 35 ? 'var(--fair)' : x <= 65 ? 'var(--muted)' : 'var(--expensive)';

---

<Base title={`${e.name} ${e.code}`}>
  <p class="small" style="margin-bottom:8px">
    <a href={`${base}/etfs/`} class="dim">← ETF 列表</a>
  </p>

  <h1>{e.name} <span class="mono dim" style="font-size:16px;font-weight:400">{e.exchange} {e.code}</span></h1>
  <p class="lede">
    {e.type} · 跟踪 {idx?.name ?? '—'} · 复盘日 {e.lastReviewed}
    {isQdii(e) && <> · <span class="badge fair">QDII</span></>}
    <span class={`badge ${ACTION_TONE[v.action]}`} style="margin-left:6px">{ACTION_LABEL[v.action]}</span>
  </p>

  {e.premium != null && e.premium > premiumLimit(e) && (
    <div class="notice" style="border-color:rgba(255,91,91,.4);margin-top:14px">
      <strong>溢价 {e.premium.toFixed(2)}%，超过 {premiumLimit(e)}% 容忍度。</strong>
      这部分钱与 {idx?.name ?? '指数'} 涨跌无关，是买入当下就承担掉的确定性损失。
      {feeYears != null && (
        <>
          {' '}换算成费率：相当于 <strong>{(e.premium / 0.8).toFixed(1)} 年</strong>的 0.8%/年综合费率。
        </>
      )}
    </div>
  )}

  <div class="section-head">
    <h2>两个判定，不能合成一句</h2>
    <span class="hint">上面是「买哪只」，下面是「什么时候买」——它们各自独立，所以可能一个对一个不对</span>
  </div>

  <div class="grid grid-2" style="gap:16px">
    <div class="card">
      <div class="kv">
        <span class="k">工具分 · 只在同指数内比较</span>
        <span
          class="v"
          style={`color:var(--${tool.grade === 'first' ? 'cheap' : tool.grade === 'competitive' ? 'fair' : 'expensive'})`}
        >
          {TOOL_LABEL[tool.grade]}
        </span>
        <span class="sub">
          {tool.total > 1 ? `同指数 ${tool.total} 只里排第 ${tool.rank}` : '同指数仅此一只'}
          {' · '}费率 {e.fee.total == null ? '待核' : `${e.fee.total}%`}
          {' · '}成交 {e.turnover == null ? '待核' : `${e.turnover} 亿`}
        </span>
      </div>
      <p class="small" style="margin:12px 0 0;line-height:1.8;color:var(--muted)">{tool.headline}。</p>
      {tool.notes.map((n) => (
        <p class="small dim" style="margin:6px 0 0;line-height:1.75">· {n}</p>
      ))}
      {tool.betterAlternative && (
        <p class="small" style="margin:12px 0 0;padding-top:10px;border-top:1px solid var(--line)">
          <span class="dim">同指数更合格的产品：</span>
          <a href={`${base}/etfs/${tool.betterAlternative}/`} class="mono" style="color:var(--accent)">
            {tool.betterAlternative}
          </a>
        </p>
      )}
    </div>

    <div class="card">
      <div class="kv">
        <span class="k">入场分 · 指数自身属性</span>
        <span class="v" style={`color:var(--${ENTRY_TONE[entry.grade] === 'unknown' ? 'muted' : ENTRY_TONE[entry.grade]})`}>
          {ENTRY_LABEL[entry.grade]}
        </span>
        <span class="sub">{entry.headline}</span>
      </div>
      {entry.blocks.length > 0 ? (
        <div class="small" style="margin:12px 0 0;line-height:1.8;color:var(--muted)">
          {entry.blocks.length > 1 || entry.headline !== entry.blocks[0] ? '不给方向的理由：' : null}
          {/* headline 已包含第一条理由时不重复渲染，避免同一句话出现两遍 */}
          {entry.blocks.filter((b) => b !== entry.headline).map((b) => (
            <div>· {b}</div>
          ))}
          {entry.notes.map((n) => (
            <div class="dim" style="margin-top:6px">※ {n}</div>
          ))}
          <div class="dim" style="margin-top:6px">
            这不是「数据没取到」，是「取到了但没有唯一读法」——补数据解决不了，只能等结构自己稳下来。
          </div>
        </div>
      ) : entry.notes.length > 0 ? (
        <div class="small" style="margin:12px 0 0;line-height:1.8;color:var(--muted)">
          {entry.notes.map((n) => (
            <div class="dim">※ {n}</div>
          ))}
          <p style="margin:8px 0 0">
            分位样本可信、没有窗口分歧、没有口径分歧——所以这一层可以给出方向。
          </p>
        </div>
      ) : (
        <p class="small" style="margin:12px 0 0;line-height:1.8;color:var(--muted)">
          分位样本可信、没有窗口分歧、没有口径分歧——所以这一层可以给出方向。
        </p>
      )}
    </div>
  </div>

  <div
    class="card"
    style={`margin-top:16px;border-left:3px solid var(--${ACTION_TONE[v.action] === 'accent' ? 'accent' : ACTION_TONE[v.action] === 'unknown' ? 'muted' : ACTION_TONE[v.action] === 'dim' ? 'dim' : ACTION_TONE[v.action]})`}
  >
    <div style="display:flex;gap:12px;align-items:baseline;flex-wrap:wrap">
      <span class={`badge ${ACTION_TONE[v.action]}`} style="font-size:12.5px;padding:3px 12px">{ACTION_LABEL[v.action]}</span>
      <strong style="font-size:15.5px">{v.sentence}</strong>
    </div>
    <p class="small muted" style="margin:8px 0 0;line-height:1.75">{ACTION_HINT[v.action]}</p>
  </div>

  {ranked.length > 1 && (
    <>
      <div class="section-head">
        <h2>同指数对比</h2>
        <span class="hint">同一件东西，不同价钱的包装——这一栏才是「买哪只」的依据</span>
      </div>
      <div class="card" style="overflow-x:auto">
        <table>
          <thead>
            <tr>
              <th>工具</th>
              <th class="num">工具分</th>
              <th class="num">费率</th>
              <th class="num">日均成交</th>
              <th class="num">溢价</th>
              <th class="num">规模</th>
              <th class="num">动作</th>
            </tr>
          </thead>
          <tbody>
            {ranked.map((r) => (
              <tr style={r.etf.code === e.code ? 'background:rgba(110,168,254,.06)' : ''}>
                <td>
                  <a href={`${base}/etfs/${r.etf.code}/`} style={r.etf.code === e.code ? 'font-weight:650' : 'font-weight:450'}>
                    {r.etf.name}
                  </a>
                  {r.etf.code === e.code && <span class="dim small"> ← 本页</span>}
                  <div class="small dim mono">{r.etf.code}</div>
                </td>
                <td class="num">
                  <span
                    class={`badge ${r.verdict.tool.grade === 'first' ? 'cheap' : r.verdict.tool.grade === 'competitive' ? 'fair' : 'expensive'}`}
                  >
                    {TOOL_LABEL[r.verdict.tool.grade]}
                  </span>
                  <div class="dim mono" style="font-size:10.5px;margin-top:3px">第 {r.rank}</div>
                </td>
                <td class="num mono">{r.etf.fee.total == null ? '—' : `${r.etf.fee.total}%`}</td>
                <td class="num mono">{r.etf.turnover == null ? '—' : `${r.etf.turnover} 亿`}</td>
                <td class="num mono">{r.etf.premium == null ? '—' : `${r.etf.premium.toFixed(2)}%`}</td>
                <td class="num mono">{r.etf.scale == null ? '—' : `${r.etf.scale} 亿`}</td>
                <td class="num">
                  <span class={`badge ${ACTION_TONE[r.verdict.action]}`}>{ACTION_LABEL[r.verdict.action]}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="small dim" style="margin:12px 0 0;line-height:1.75">
          排名只在同一档位内可比：档位先比（同类最优 → 竞争档 → 落后），同档内按费率升序、成交额降序。
          这里没有加权求和——费率与流动性都是「每次交易/每年」都要付的东西，谁重谁轻取决于你打算持有多久，不该由规则替你定。
        </p>
      </div>
    </>
  )}

  <div class="grid grid-3" style="margin-top:16px">
    <div class="card">
      <div class="kv">
        <span class="k">溢价率</span>
        <span class="v" style={`color:${e.premium == null ? 'var(--dim)' : e.premium > premiumLimit(e) ? 'var(--expensive)' : 'var(--cheap)'}`}>
          {e.premium == null ? '待核' : `${e.premium > 0 ? '+' : ''}${e.premium.toFixed(2)}%`}
        </span>
        <span class="sub">
          收盘 {e.price ?? '—'}（{e.priceAsOf ?? '—'}）／净值 {e.nav ?? '—'}（{e.navAsOf ?? '—'}）
        </span>
      </div>
    </div>
    <div class="card">
      <div class="kv">
        <span class="k">综合费率（年）</span>
        <span class="v">{e.fee.total == null ? '待核' : `${e.fee.total}%`}</span>
        <span class="sub">{e.fee.note}</span>
      </div>
    </div>
    <div class="card">
      <div class="kv">
        <span class="k">规模 / 日均成交</span>
        <span class="v">
          {e.scale == null ? '待核' : `${e.scale} 亿`}
        </span>
        <span class="sub">
          成交 {e.turnover == null ? '待核' : `${e.turnover} 亿`}{e.turnoverAsOf ? `（${e.turnoverAsOf}）` : ''}
        </span>
      </div>
    </div>
  </div>

  <div class="section-head"><h2>申购状态</h2><span class="hint">这一项决定「能不能按净值买到」</span></div>
  <div class="card">
    <div style="display:flex;gap:10px;align-items:center;margin-bottom:10px">
      <span class={`badge ${e.subscription === 'open' ? 'cheap' : e.subscription === 'limited' ? 'fair' : 'expensive'}`}>
        {SUBSCRIPTION_LABEL[e.subscription]}
      </span>
    </div>
    <p class="muted" style="margin:0">{e.subscriptionNote}</p>
    {e.subscription === 'suspended' && (
      <p class="small" style="margin:12px 0 0;padding-top:12px;border-top:1px solid var(--line);color:var(--expensive)">
        申购关闭时，套利只能单向（卖出存量份额），无法创造新份额来平抑溢价。所以「暂停申购 + 高溢价」是自我强化的，
        不会自己好起来，除非额度恢复或需求退潮。
      </p>
    )}
  </div>

  <div class="section-head"><h2>底层指数估值</h2><span class="hint">ETF 便宜不便宜，看的是这里</span></div>
  {idx && (
    <div class="card">
      <div class="grid grid-2" style="gap:18px">
        <div class="kv">
          <span class="k">{idx.name} PE</span>
          <span class="v" style={typeof idx.pe === 'number' && idx.pe <= 0 ? 'color:var(--expensive)' : ''}>
            {idx.pe ?? '—'}
          </span>
          <span
            class="sub"
            style={pbOnly ? 'color:var(--expensive)' : wc ? 'color:var(--fair)' : val ? `color:${pctColor(val.value)}` : ''}
          >
            {pbOnly
              ? '整体亏损，PE 分位不参与判断'
              : val
                ? `${val.basis} ${val.value.toFixed(0)}${
                    typeof idx.pePct.y3 === 'number'
                      ? `（3 年 ${idx.pePct.y3}、5 年 ${idx.pePct.y5 ?? '—'}）`
                      : ''
                  }`
                : '分位缺失'}
          </span>
        </div>
        <div class="kv">
          <span class="k">PB</span>
          <span class="v">{idx.pb ?? '—'}</span>
          <span class="sub">
            {pbOnly ? '本层改用：' : ''}
            {(() => {
              const pb = pbPercentile(idx);
              return pb ? `${pb.basis} ${pb.value.toFixed(0)}` : '分位缺失';
            })()}
          </span>
        </div>
        <div class="kv">
          <span class="k">ROE（= PB ÷ PE）</span>
          <span class="v" style={typeof idx.roe === 'number' && !(idx.roe > 0) ? 'color:var(--expensive)' : ''}>
            {idx.roe == null ? '—' : `${idx.roe}%`}
          </span>
          <span class="sub">
            {typeof idx.roe === 'number' && !(idx.roe > 0) ? '净资产在被亏损吃掉' : '净资产还在增值'}
          </span>
        </div>
        <div class="kv">
          <span class="k">股息率 / 隐含派息率</span>
          <span class="v" style={payoutHigh ? 'color:var(--fair)' : ''}>
            {idx.dividendYield == null ? '—' : `${idx.dividendYield}%`}
          </span>
          <span class="sub" style={payoutHigh ? 'color:var(--fair)' : ''}>
            {payout == null ? `数据日 ${idx.asOf}` : `股息率 × PE = ${payout.toFixed(0)}% 利润要分掉`}
          </span>
        </div>
      </div>
      {pbOnly && val && (
        <p class="small" style="margin:16px 0 0;padding:12px;background:var(--panel-2);border-left:2px solid var(--expensive);border-radius:0 4px 4px 0;line-height:1.8">
          <strong style="color:var(--expensive)">估值层换尺子了：</strong>
          {val.fallbackReason}。{val.equityErosion}
        </p>
      )}
      {wc && (
        <p
          class="small"
          style="margin:16px 0 0;padding:12px;background:var(--panel-2);border-left:2px solid var(--fair);border-radius:0 4px 4px 0;line-height:1.8"
        >
          <strong style="color:var(--fair)">分位在打架：</strong>
          {wc.long.label}分位 {wc.long.value.toFixed(0)}、{wc.short.label}分位 {wc.short.value.toFixed(0)}，差{' '}
          {wc.gap.toFixed(0)} 个百分点且方向相反。<strong>{wc.reason}</strong>
          换一段窗口，结论就从「便宜」翻成「偏贵」——所以估值层只判「部分通过」。
          这不是数据缺失（样本是完整的），是这段历史没有唯一读法。
        </p>
      )}
      {payoutHigh && payout != null && (
        <p
          class="small"
          style="margin:12px 0 0;padding:12px;background:var(--panel-2);border-left:2px solid var(--fair);border-radius:0 4px 4px 0;line-height:1.8"
        >
          <strong style="color:var(--fair)">股息率 {idx.dividendYield}% 里有水分：</strong>
          股息率 ÷ 盈利收益率 = 派息率，反解出来是 {payout.toFixed(0)}%，也就是要把{' '}
          {payout.toFixed(0)}% 的利润分掉才够。真实的派息率通常在 65–80%，差的那一截来自时点错配——
          分子是按上一年利润派出去的现金，分母是今天已经跌过的股价，而 PE 的分母是最近四季度
          已经下滑的净利润。利润先跌、分红后跌，股息率就被虚高了。所以「股息率 − 国债」的利差
          在这里只能算「看起来过了」，它假设股息可持续，而分红率已经没有继续提的空间。
        </p>
      )}
      {psc && (
        <p
          class="small"
          style="margin:12px 0 0;padding:12px;background:var(--panel-2);border-left:2px solid var(--fair);border-radius:0 4px 4px 0;line-height:1.8"
        >
          <strong style="color:var(--fair)">同一天两个 PE：{psc.main} 与 {psc.alt}，差 {(psc.gap * 100).toFixed(0)}%。</strong>
          {psc.reason}。另一来源来自 {psc.source}
          {idx.peAlt?.pct5y != null ? `，它给的分位是 ${idx.peAlt.pct5y}%（便宜）` : ''}，
          与整体法的 {idx.pePct.y10}%（偏贵）正好相反。
          <strong>所以估值层不判「贵」也不判「便宜」，只判「说不清」。</strong>
        </p>
      )}
      {idx.peCaveat && (
        <p class="small muted" style="margin:16px 0 0;padding-top:12px;border-top:1px solid var(--line);line-height:1.75">
          <strong style="color:var(--fair)">口径提示：</strong>{idx.peCaveat}
        </p>
      )}
      <div class="small dim" style="margin-top:10px">
        来源：{idx.sources.join('；')}
      </div>
    </div>
  )}

  <div class="section-head"><h2>在组合里的角色</h2></div>
  <div class="card">
    <p class="muted" style="margin:0 0 12px">{e.role}</p>
    <ul class="clean" style="padding-left:20px;line-height:1.85;margin:0">
      {e.caveats.map((c) => <li>{c}</li>)}
    </ul>
  </div>
</Base>
