---
import Base from '../../layouts/Base.astro';
import etfsData from '../../../data/etfs.json';
import {
  etfThreeLayer,
  deriveEtfStatus,
  etfPending,
  indexPercentile,
  indexValuation,
  peSourceConflict,
  percentileWindowConflict,
  percentileReliability,
  peerFee,
  premiumInFeeYears,
  isQdii,
  premiumLimit,
  SUBSCRIPTION_LABEL,
  STATE_LABEL,
  STATUS_LABEL,
  ETF_FEE_MAX,
  ETF_TURNOVER_MIN,
  type EtfsFile,
  type Etf,
  type EtfIndex,
} from '../../lib/rules';

const data = etfsData as unknown as EtfsFile;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const idxOf = (id: string) => data.indices.find((i) => i.id === id);

const stOf = (e: Etf) => deriveEtfStatus(e, idxOf(e.indexId), data.etfs);
const rank = { buy: 0, watch: 1, avoid: 2 } as const;
const sorted = [...data.etfs].sort((a, b) => {
  const r = rank[stOf(a)] - rank[stOf(b)];
  if (r !== 0) return r;
  return (premiumInFeeYears(a) ?? -1) - (premiumInFeeYears(b) ?? -1);
});

const STATE_CLASS = { pass: 'cheap', partial: 'fair', fail: 'expensive' } as const;

/**
 * 卡点分布：把「需观察」拆开。
 * 多数是需观察，但「指数贵」「工具贵」「数据没取到」是三件完全不同的事，
 * 混成一个数字会让人以为「全部不能买」，那正是这个面板要避免的误读。
 */
const blockers = data.etfs.map((e) => {
  const L = etfThreeLayer(e, idxOf(e.indexId), data.etfs);
  const fails = L.filter((l) => l.state === 'fail');
  const partials = L.filter((l) => l.state === 'partial');
  let kind: 'ready' | 'evidence' | 'one-fail' | 'hard-fail';
  if (fails.length === 0 && partials.length === 0) kind = 'ready';
  else if (fails.length === 0) kind = 'evidence';
  else if (fails.length === 1) kind = 'one-fail';
  else kind = 'hard-fail';
  return { e, kind, fails, partials };
});
const blockerCount = {
  ready: blockers.filter((b) => b.kind === 'ready').length,
  evidence: blockers.filter((b) => b.kind === 'evidence').length,
  oneFail: blockers.filter((b) => b.kind === 'one-fail').length,
  hardFail: blockers.filter((b) => b.kind === 'hard-fail').length,
};

const groups = [
  { status: 'buy' as const, hint: '成本、估值、可用三层全部通过——可以按计划配置' },
  { status: 'watch' as const, hint: '有明确未过项，或关键数据待核——先补数据或等条件' },
  { status: 'avoid' as const, hint: '两项以上明确不合格——通常是「指数便宜，但工具在收你过路费」' },
];

// 溢价换算：把「贵一点」翻译成「多少年费率」
const REF_FEE = 0.8;
const worst = data.etfs
  .filter((e) => e.premium != null && e.premium > 2)
  .sort((a, b) => (b.premium ?? 0) - (a.premium ?? 0));
const suspendedPremium = data.etfs.filter(
  (e) => e.subscription === 'suspended' && e.premium != null && (e.premium ?? 0) > premiumLimit(e)
);

const pctColor = (p: number) =>
  p <= 15 ? 'var(--cheap)' : p <= 35 ? 'var(--fair)' : p <= 65 ? 'var(--muted)' : 'var(--expensive)';

// PE 分位与 PB 分位的背离 = ROE 变化的痕迹。
// PB / PE = ROE，所以「PB 分位低但 PE 分位高」只有一种解释：净资产还在，赚钱能力退了。
// 这条规则是自动的，不针对某一只指数——任何新加进来的指数都会被同一把尺子量一遍。
// 注意：PE ≤ 0 的指数不进这张表。负 PE 的分位是「亏得多深」的名次，与 PB 分位的差
// 不是 ROE 下行的痕迹，而是亏损本身的痕迹——放进来会产生一条看起来极端的假背离。
const divergences = data.indices
  .filter((i) => typeof i.pe === 'number' && i.pe > 0)
  .filter((i) => typeof i.pePct.y10 === 'number' && typeof i.pbPct.y10 === 'number')
  .map((i) => ({
    name: i.name,
    code: i.code,
    pePct: i.pePct.y10 as number,
    pbPct: i.pbPct.y10 as number,
    gap: (i.pePct.y10 as number) - (i.pbPct.y10 as number),
    roe: i.roe ?? (i.pb && i.pe ? +((i.pb / i.pe) * 100).toFixed(2) : null),
  }))
  .filter((i) => Math.abs(i.gap) > 30)
  .sort((a, b) => Math.abs(b.gap) - Math.abs(a.gap));
---

<Base
  title="ETF 工具"
  subtitle="同一个指数有多个 ETF，先比成本，再谈估值。ETF 的三层和个股不同：溢价与费率是确定性的损耗，指数分位是估值判断，申购状态决定能不能执行。"
>
  <h1>ETF 工具</h1>

  <div class="notice" style="border-color:rgba(255,91,91,.35)">
    <strong>先看这一条：场内买高溢价 QDII，等于买入即亏。</strong>
    标普500LOF（161125）当前溢价 <strong>6.10%</strong>，且自 2026-03-19 起<strong>暂停申购与定投</strong>；
    纳斯达克100LOF（161130）溢价 <strong>11.23%</strong>，处 60 日 98.33% 分位。
    申购通道关闭意味着溢价无法靠套利机制回归——这个 6% 可能维持很久，也可能在某天恢复申购时一次性收敛掉。
    <div style="margin-top:8px">
      把溢价换成可比较的单位：<strong>6.10% ÷ {REF_FEE}%（同类最低综合费率）≈ 7.6 年费率</strong>。
      换句话说，为了省每年 0.8% 的费用去场内全额付掉 6.1% 溢价，要 7.6 年才回本；反过来说，等溢价收敛到零，等于白拿 7.6 年的费率。
    </div>
  </div>

  <div class="section-head">
    <h2>底层指数：先看便宜不便宜</h2>
    <span class="hint">ETF 的价格不重要，它跟踪的指数贵不贵才重要</span>
  </div>
  <div class="card" style="overflow-x:auto">
    <table>
      <thead>
        <tr>
          <th>指数</th>
          <th class="num">PE</th>
          <th class="num">PE 分位 3y / 5y / 10y</th>
          <th class="num">PB</th>
          <th class="num">PB 分位 10y</th>
          <th class="num">股息率</th>
          <th>分位可信度</th>
          <th class="num">数据日</th>
        </tr>
      </thead>
      <tbody>
        {data.indices.map((i) => {
          /* 注意：这类判断必须写成 JS 常量，不要塞进 JSX 里的 IIFE，
             也不要在模板表达式里写 `<=`——Astro 编译器会把它当成标签起始，
             报「Unable to assign attributes when using <> Fragment shorthand syntax」。
             这是 2026-11 加光伏时踩到的坑，记在这里避免下次再犯。 */
          const peNegative = typeof i.pe === 'number' && !(i.pe > 0);
          const val = indexValuation(i);
          const rel = val ? percentileReliability(i, val.window, i.asOf) : null;
          const relColor =
            rel?.level === 'low' ? 'var(--expensive)' : rel?.level === 'medium' ? 'var(--fair)' : 'var(--cheap)';
          const relLabel = rel?.level === 'low' ? '低' : rel?.level === 'medium' ? '中' : '高';
          return (
            <tr>
              <td>
                <strong>{i.name}</strong>
                <div class="small dim mono">{i.code} · {i.currency}</div>
              </td>
              <td class="num mono">
                <span
                  style={peNegative ? 'color:var(--expensive);font-weight:600' : ''}
                  title={peNegative ? '整体法 PE 为负：成分股合计净利润为负，这个数字本身不参与估值判断' : undefined}
                >
                  {i.pe ?? '—'}
                  {peNegative && <span style="font-size:10px;margin-left:3px">亏损</span>}
                </span>
              </td>
              <td class="num mono small">
                <span
                  style={peNegative ? 'text-decoration:line-through;opacity:.45' : ''}
                  title={peNegative ? 'PE 为负，百分位失去方向含义：行业越亏，PE 越负，分位可能越「便宜」。本表不以它判断估值。' : undefined}
                >
                  {(['y3', 'y5', 'y10'] as const).map((w, k) => (
                    <>
                      {k > 0 && <span class="dim"> / </span>}
                      <span
                        style={
                          typeof i.pePct[w] === 'number'
                            ? `color:${pctColor(i.pePct[w] as number)}`
                            : 'color:var(--dim)'
                        }
                      >
                        {typeof i.pePct[w] === 'number' ? (i.pePct[w] as number).toFixed(0) : '—'}
                      </span>
                    </>
                  ))}
                </span>
              </td>
              <td class="num mono">{i.pb ?? '—'}</td>
              <td
                class="num mono"
                style={typeof i.pbPct.y10 === 'number' ? `color:${pctColor(i.pbPct.y10)}` : ''}
                title={peNegative ? 'PB 分位低在这里不代表便宜：ROE 为负，净资产正在被亏损吃掉' : undefined}
              >
                {typeof i.pbPct.y10 === 'number' ? `${i.pbPct.y10.toFixed(0)}` : '—'}
                {peNegative && <span class="dim" style="font-size:10px"> *</span>}
              </td>
              <td class="num mono">{i.dividendYield == null ? '—' : `${i.dividendYield}%`}</td>
              <td class="small">
                {rel ? (
                  <span style={`color:${relColor}`} title={rel.reason}>
                    {relLabel}
                  </span>
                ) : (
                  <span class="dim">—</span>
                )}
              </td>
              <td class="num small dim mono">{i.asOf}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
    <div class="small" style="margin:14px 0 0;padding:12px;background:var(--panel-2);border-left:2px solid var(--fair);border-radius:0 4px 4px 0">
      <strong>「分位可信度」这一列是什么：</strong>
      <span class="dim">
        分位低只说明「比自己过去便宜」，前提是过去那段样本与现在是同一个东西。两种情况会破坏这个前提——
        指数发布不足 10 年却用了 10 年分位（那段历史是回溯模拟的），以及编制方法近期大改（变更前后不是同一个指数）。
        可信度为「低」时，即使分位通过，估值层也只算「部分通过」，不会因为便宜就给出可配置的结论。
        鼠标悬停可以看到具体原因。
      </span>
    </div>
    {data.indices
      .map((i) => ({ i, ps: peSourceConflict(i) }))
      .filter((x) => x.ps)
      .map(({ i, ps }) => (
        <div class="notice" style="border-color:rgba(245,166,35,.45);margin-top:14px">
          <strong>
            {i.name}（{i.code}）同一天有两个 PE：{ps!.main} 和 {ps!.alt}，差{' '}
            {(ps!.gap * 100).toFixed(0)}%。
          </strong>
          <div class="small" style="margin-top:6px;line-height:1.8">
            两个数都像正常市盈率，看不出谁错——差别在<strong>分母里有没有亏损样本</strong>。
            整体法把亏损公司算进分母，行业利润变小、PE 就高，回答的是「整个行业按利润回本要几年」；
            剔除亏损口径只统计还在赚钱的公司，PE 就低，回答的是「赚钱的那部分要几年」。
            <br />
            麻烦的是结论会翻：整体法 {i.pePct.y10}% 分位（偏贵），另一口径
            {i.peAlt?.pct5y ?? ''}% 分位（便宜）。
            <strong>同一个东西两个价钱，说明「贵不贵」这件事本身还没有答案。</strong>
            规则据此硬编码：<span class="mono">两口径差 &gt; {Math.round(0.2 * 100)}% → 估值层最高只判部分通过</span>。
            这不是「贵」，是「说不清」——给一个数比给两个数更需要理由。
          </div>
        </div>
      ))}

    {data.indices
      .map((i) => ({ i, wc: percentileWindowConflict(i) }))
      .filter((x) => x.wc)
      .map(({ i, wc }) => (
        <div class="notice" style="border-color:rgba(245,166,35,.45);margin-top:14px">
          <strong>
            {i.name}（{i.code}）的三个分位在打架：{wc!.long.label} {wc!.long.value.toFixed(0)}、{wc!.short.label}{' '}
            {wc!.short.value.toFixed(0)}，差 {wc!.gap.toFixed(0)} 个百分点且方向相反。
          </strong>
          <div class="small" style="margin-top:6px;line-height:1.8">
            两个数字都是真的，分歧在于<strong>拿哪一段当锚</strong>。{wc!.long.label}窗口里套着上一轮泡沫的极端估值——
            那段时间把 PE 推到过一个之后大概不会再回去的高度，窗口上界被抬高，今天的 {i.pe} 倍自然显得便宜；
            但对近年才进场的人来说，这段历史里可能从来没有过这么低的估值，{wc!.short.label}分位{' '}
            {wc!.short.value.toFixed(0)} 才是他亲身经历的「贵」。
            规则硬编码：<span class="mono">长窗口 ≤35 且短窗口 ≥65 → 判为窗口分歧，估值层不得判通过</span>。
            <br />
            注意这和「样本不够」是两件不同的事：回溯模拟、编制变更那类是<strong>分位算得不对</strong>；
            这一类是<strong>分位算得对，但没有唯一含义</strong>——换一段窗口，结论就从「便宜」翻成「偏贵」。
            所以本表不给你一个单数，两个都摆出来。
          </div>
        </div>
      ))}

    {data.indices
      .filter((i) => typeof i.pe === 'number' && !(i.pe > 0))
      .map((i) => (
        <div class="notice" style="border-color:rgba(255,91,91,.4);margin-top:14px">
          <strong>{i.name}（{i.code}）的 PE 是 {i.pe}，不是「很低的市盈率」，是负数。</strong>
          <div class="small" style="margin-top:6px;line-height:1.8">
            整体法口径下成分股合计净利润为负，PE 没有经济含义。表里那三个 PE 分位
            （{i.pePct.y3} / {i.pePct.y5} / {i.pePct.y10}）是<strong>把负数排序</strong>排出来的——行业越亏，PE 越负，名次可能越「便宜」，
            所以它们被划掉了：读得出数字，读不出结论。
            估值层改用 PB {i.pb} 倍（10 年分位 {i.pbPct.y10}%），但 ROE {i.roe}% 说明
            <strong>净资产本身在被亏损吃掉</strong>，PB 的分母还在变小——这是价值陷阱的形态，不是安全边际。
            规则据此硬编码：<span class="mono">PE ≤ 0 → PE 分位失效，改用 PB，且估值层最高只判「部分通过」</span>。
          </div>
        </div>
      ))}

    <div class="small dim" style="margin:14px 0 0;line-height:1.75">
      {data.indices
        .filter((i) => i.peCaveat)
        .map((i) => (
          <div style="margin-bottom:8px">
            <strong style="color:var(--fair)">{i.name} 口径：</strong>{i.peCaveat}
          </div>
        ))}
    </div>
  </div>

  <div class="card" style="margin-top:14px">
    <h3 style="margin-top:0">PE 分位与 PB 分位打架时，看 ROE</h3>
    <p class="small muted" style="margin-top:0">
      PB ÷ PE 就是 ROE。所以「PB 分位低、PE 分位高」不是数据错误，是净资产还在、赚钱能力退了——
      这种便宜是假便宜。「PB 分位高、PE 分位低」则相反：市场愿意为净资产付高价，因为它的盈利率真的高。
      下表是差值超过 30 个百分点的指数，自动筛出，不用手填。
    </p>
    <div style="overflow-x:auto">
      <table style="margin-top:6px">
        <thead>
          <tr>
            <th>指数</th><th class="num">PE 分位</th><th class="num">PB 分位</th>
            <th class="num">差值</th><th class="num">ROE</th><th>读法</th>
          </tr>
        </thead>
        <tbody>
          {divergences.map((d) => (
            <tr>
              <td><strong>{d.name}</strong> <span class="small dim mono">{d.code}</span></td>
              <td class="num mono" style={`color:${pctColor(d.pePct)}`}>{d.pePct.toFixed(1)}</td>
              <td class="num mono" style={`color:${pctColor(d.pbPct)}`}>{d.pbPct.toFixed(1)}</td>
              <td class="num mono" style="font-weight:600">{d.gap > 0 ? '+' : ''}{d.gap.toFixed(1)}</td>
              <td class="num mono">{d.roe == null ? '—' : `${d.roe}%`}</td>
              <td class="small" style={`color:${d.roe == null ? 'var(--dim)' : d.gap > 0 ? 'var(--expensive)' : 'var(--cheap)'}`}>
                {d.roe == null
                  ? 'ROE 未取得，背离待核'
                  : d.gap > 0
                    ? 'ROE 下行：PB 便宜是假便宜'
                    : 'ROE 高位：PB 贵是赚钱能力撑的'}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {divergences.length === 0 && <p class="small dim" style="margin:0">当前没有背离超过 30pct 的指数。</p>}
    <p class="small dim" style="margin:12px 0 0">
      反例最清楚的是沪深300：PE 分位 69%、PB 分位 20%，差 50 个百分点，而 ROE 只有 9.87%。
      如果只看 PB「十年 20% 分位」就判断便宜，会漏掉最关键的一句——便宜的是资产，不是盈利能力。
      {data.indices.some((i) => typeof i.pe === 'number' && !(i.pe > 0)) && (
        <>
          <br />
          <strong style="color:var(--expensive)">负 PE 的指数不进这张表。</strong>
          它们的 PE 与 PB 分位差不是「ROE 下行」而是「亏损在扩大」，放进来会排出一条极端却无意义的假背离。
          这类指数的处理写在上面那张指数表里：换尺子（PE → PB），换完尺子之后也不给通过。
        </>
      )}
    </p>
  </div>

  <div class="card" style="margin-top:14px">
    <a href={`${base}/etfs/dividend/`} style="display:flex;align-items:center;gap:10px">
      <span class="small" style="flex:1">
        <strong style="color:var(--text)">红利低波（H30269）单独体检</strong>
        <span class="dim">　54% 银行、PE 5 年分位 99.7%、股息率 4.62% 但不发现金——三件事需要一起看</span>
      </span>
      <span class="small" style="color:var(--accent)">查看 →</span>
    </a>
  </div>

  <div class="section-head">
    <h2>ETF 三层</h2>
    <span class="hint">成本 → 估值 → 可用，顺序不能倒：先别付过路费，再谈买什么</span>
  </div>

  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px">
    {[
      { n: blockerCount.ready, label: '三层全过', sub: '可按计划配置', color: 'var(--cheap)' },
      { n: blockerCount.evidence, label: '只是证据不齐', sub: '不贵，但还证明不了便宜', color: 'var(--fair)' },
      { n: blockerCount.oneFail, label: '一层明确不合格', sub: '贵 / 工具贵 / 买不到，选其一', color: 'var(--muted)' },
      { n: blockerCount.hardFail, label: '两层以上不合格', sub: '真实缺陷，回避', color: 'var(--expensive)' },
    ].map((b) => (
      <div class="card" style="padding:12px 14px">
        <div class="mono" style={`font-size:24px;font-weight:600;color:${b.color}`}>{b.n}</div>
        <div class="small" style="font-weight:550;margin-top:2px">{b.label}</div>
        <div class="small dim" style="margin-top:2px;line-height:1.5">{b.sub}</div>
      </div>
    ))}
  </div>
  <p class="small dim" style="margin:-4px 0 14px;line-height:1.75">
    这四格比「可配置 / 需观察 / 回避」三个状态更有用：{data.etfs.length} 只里有 {blockerCount.evidence} 只
    并不是「贵」，而是<strong>便宜的证明链不完整</strong>——分位样本不可比、或折溢价没取到。
    这两类要分开看，因为前者等指数结构稳定下来就会消失，后者补一次数据就能消失，
    而「贵」只能等价格。
    {blockerCount.ready > 0 && (
      <>
        <br />
        <strong>「三层全过」只说明工具与估值同时合格，不是仓位建议。</strong>
        它不评估波动与回撤——港股通互联网这类品种年化波动 30%+、最大回撤接近 50%，
        仓位要按你能承受的回撤倒推，而不是按「便宜」推。
      </>
    )}
  </p>
  <div class="card" style="overflow-x:auto">
    <table>
      <thead>
        <tr>
          <th>工具</th>
          <th class="num">类型</th>
          <th class="num">① 成本</th>
          <th class="num">② 估值</th>
          <th class="num">③ 可用</th>
          <th class="num">溢价</th>
          <th class="num">费率</th>
          <th class="num">状态</th>
        </tr>
      </thead>
      <tbody>
        {sorted.map((e) => {
          const idx = idxOf(e.indexId);
          const layers = etfThreeLayer(e, idx, data.etfs);
          const st = stOf(e);
          const pending = etfPending(e, idx, data.etfs);
          return (
            <tr>
              <td>
                <a href={`${base}/etfs/${e.code}/`} style="font-weight:550">{e.name}</a>
                <div class="small dim mono">{e.exchange} {e.code} · {idxOf(e.indexId)?.name ?? e.indexId}</div>
              </td>
              <td class="num small">{e.type}</td>
              {layers.map((l) => (
                <td class="num">
                  <span class={`badge ${STATE_CLASS[l.state]}`} title={l.detail} style="cursor:help">
                    {STATE_LABEL[l.state]}
                  </span>
                  <div class="dim" style="font-size:11px;margin-top:3px;max-width:15ch;margin-left:auto">{l.headline}</div>
                </td>
              ))}
              <td class="num mono" style={`font-weight:600;color:${e.premium != null && e.premium > 2 ? 'var(--expensive)' : 'var(--muted)'}`}>
                {e.premium == null ? '—' : `${e.premium > 0 ? '+' : ''}${e.premium.toFixed(2)}%`}
              </td>
              <td class="num mono">
                {e.fee.total == null ? '—' : `${e.fee.total}%`}
                {(() => {
                  const pf = peerFee(e, data.etfs);
                  if (!pf || e.fee.total == null || pf.ratio < 1.2) return null;
                  return (
                    <div
                      class="dim"
                      style={`font-size:10.5px;margin-top:3px;color:${pf.ratio >= 1.5 ? 'var(--expensive)' : 'var(--dim)'}`}
                      title={`同指数可比产品最低 ${pf.min}%/年（${pf.codes.join('、')}）`}
                    >
                      最低 {pf.min}%
                    </div>
                  );
                })()}
              </td>
              <td class="num">
                <span class={`badge ${st}`}>{STATUS_LABEL[st]}</span>
                {pending > 0 && <div class="dim" style="font-size:10.5px;margin-top:3px">{pending} 项待核</div>}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
    <p class="small dim" style="margin:14px 0 0;line-height:1.75">
      ① <strong>成本层</strong>：折溢价超过容忍度（境内 1%／QDII 2%）判不合格——因为这部分钱跟指数涨跌无关，
      是确定性的损耗；综合费率上限 {ETF_FEE_MAX}%/年。<br />
      ② <strong>估值层</strong>：只看底层指数 PE 分位（≤35 通过 / 35–65 中性 / &gt;65 偏贵），不看 ETF 自己的价格。<br />
      ③ <strong>可用层</strong>：申购状态 + 日均成交额（下限 {ETF_TURNOVER_MIN} 亿）。工具执行不了，前两层都白算。<br />
      <strong>① 还有一条相对锚</strong>：同一指数的多只产品里，费率比最低那只高 {0.2}pct 以上且达到 1.5 倍时，成本层降为「部分」——
      0.60% 本身不贵（在 {ETF_FEE_MAX}% 上限内），但同款只要 0.20% 时，多付的 0.40pct/年 买不到任何东西。费率列下面那行「最低 X%」就是这条规则的结果。<br />
      <strong>关于「待核」</strong>：标为「部分」的层不一定是坏消息，多数是快照里没取到折溢价（需要盘中 IOPV）。
      缺数据不能当不合格用，所以状态上单列，不并进「回避」。
    </p>
  </div>

  <div class="section-head">
    <h2>溢价的真实代价</h2>
    <span class="hint">这一栏比估值分位更值得看</span>
  </div>
  <div class="grid grid-3">
    {worst.map((e) => {
      const years = premiumInFeeYears(e);
      return (
        <div class="card" style="border-color:rgba(255,91,91,.28)">
          <div class="kv">
            <span class="k">{e.name} 溢价</span>
            <span class="v" style="color:var(--expensive)">{e.premium?.toFixed(2)}%</span>
            <span class="sub">
              相对 {REF_FEE}%/年 费率 = <strong style="color:var(--expensive)">{((e.premium ?? 0) / REF_FEE).toFixed(1)} 年</strong>
              的持有成本
            </span>
            <span class="sub" style="margin-top:6px;color:var(--muted)">{e.premiumNote}</span>
          </div>
        </div>
      );
    })}
  </div>

  {suspendedPremium.length > 0 && (
    <div class="notice" style="margin-top:14px">
      <strong>这两只的问题是同一个机制：</strong>QDII 额度用尽 → 暂停申购 → 新增需求只能在场内抢存量份额 → 溢价抬升 →
      溢价本身又吸引套利资金进场 → 但因为不能申购，套利只能单向（卖出持有的份额），无法创造新份额平抑价格。
      所以「暂停申购 + 高溢价」是一个自我强化的组合，不会自己好起来，除非额度恢复或需求退潮。
      <div style="margin-top:6px" class="small dim">
        受影响的：{suspendedPremium.map((e) => `${e.name}（${e.code}）`).join('、')}
      </div>
    </div>
  )}

  <div class="card" style="margin-top:14px;border-left:2px solid var(--expensive)">
    <h3 style="margin-top:0">反过来也有陷阱：QDII 的「折价」多半是假的</h3>
    <p class="muted" style="margin-top:0">
      很多行情软件会显示恒生科技 ETF「折价 2.3%」，看着像捡钱。但它算的是
      <span class="mono">当日价格 ÷ 最新公布净值 − 1</span>，而 QDII 的净值 <strong>T+1 才确认</strong>。
      港股当天涨 5%、价格跟上了、净值还停在昨天，除出来的就是两三个点的假折价。
    </p>
    <div class="small" style="background:var(--panel-2);padding:10px 12px;border-radius:4px;line-height:1.8">
      <strong>同一个时点、同一只产品，两个口径差 2 个百分点：</strong><br />
      恒生科技ETF华夏（513180）2026-11-05：价格 0.515 ÷ 净值 0.5222 − 1 = <span style="color:var(--expensive)">−2.34%（假折价）</span><br />
      同一天交易所 IOPV 口径：<span style="color:var(--cheap)">−0.27%（真折价）</span>
    </div>
    <p class="small dim" style="margin:10px 0 0">
      结论：<strong>QDII 的折溢价只能看交易所 IOPV，不能看「价格 ÷ 净值」</strong>。
      本页对这几只产品不填溢价率，就是因为拿不到同一时点的价格与 IOPV 配对——
      与其填一个会误导人的 −2.3%，不如标「待核」。
      这也解释了为什么恒生科技的四只 ETF 成本层是「部分」：不是工具坏了，是数据配不上。
    </p>
  </div>

  {groups.map((g) => {
    const list = sorted.filter((e) => stOf(e) === g.status);
    if (list.length === 0) return null;
    return (
      <>
        <div class="section-head">
          <h2>
            <span class={`badge ${g.status}`}>{STATUS_LABEL[g.status]}</span>
            <span style="font-size:14px;font-weight:400;color:var(--muted);margin-left:10px">{g.hint}</span>
          </h2>
          <span class="hint">{list.length} 只</span>
        </div>
        <div class="card" style="overflow-x:auto">
          <table>
            <thead>
              <tr>
                <th>工具</th>
                <th class="num">规模（亿）</th>
                <th class="num">日均成交（亿）</th>
                <th class="num">申购状态</th>
                <th>在组合里的角色</th>
              </tr>
            </thead>
            <tbody>
              {list.map((e) => (
                <tr>
                  <td>
                    <a href={`${base}/etfs/${e.code}/`} style="font-weight:550">{e.name}</a>
                    <div class="small dim mono">{e.fullName}</div>
                  </td>
                  <td class="num mono">{e.scale ?? '—'}</td>
                  <td class="num mono">{e.turnover ?? '—'}</td>
                  <td class="num">
                    <span class={`badge ${e.subscription === 'open' ? 'cheap' : e.subscription === 'limited' ? 'fair' : 'expensive'}`}>
                      {SUBSCRIPTION_LABEL[e.subscription]}
                    </span>
                  </td>
                  <td class="small muted" style="max-width:34ch">{e.role}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    );
  })}

  <div class="notice info" style="margin-top:28px">
    <strong>为什么 ETF 不用「安全边际」这个词</strong>：个股的安全边际来自价格相对价值打折，可以等；ETF 的额外收益有两个来源——
    指数本身变便宜，以及<strong>你不再为它付溢价</strong>。后者是确定性的、当下可执行的，前者要等市场。
    所以这一页把「不付溢价」放在第一层，而不是当成一个提示。
  </div>
</Base>
