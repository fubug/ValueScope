---
import Dashboard from '../layouts/Dashboard.astro';
import CompareChart from '../components/CompareChart';
import { getAllMarketTrends, getLatestReport } from '../lib/data';

const trends = getAllMarketTrends('ALL');
const latest = getLatestReport();

const topMarkets = latest
  ? [...latest.markets].sort((a, b) => b.fish_score - a.fish_score).slice(0, 5).map((m) => m.market)
  : trends.slice(0, 5).map((t) => t.market);
---

<Dashboard title="市场对比">
  <div class="page-header">
    <h1>多市场鱼情对比</h1>
  </div>
  <div class="card">
    {trends.length > 0
      ? <CompareChart client:load trends={trends} defaultSelected={topMarkets} />
      : <div class="empty">暂无数据</div>
    }
  </div>
</Dashboard>

<style>
  .page-header { margin-bottom: 20px; }
  .page-header h1 { font-size: 24px; font-weight: 700; }
  .empty { text-align: center; padding: 60px; color: var(--text-secondary); }
</style>
