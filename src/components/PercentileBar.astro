---
interface Props {
  value: number | null;
  label?: string;
  showTicks?: boolean;
}
const { value, label, showTicks = true } = Astro.props;
const pos = value == null ? 0 : Math.min(100, Math.max(0, value));
---
{value == null ? (
  <span class="dim small mono">无分位数据</span>
) : (
  <div class="pbar" title={`${label ?? '分位'}：${value.toFixed(1)}`}>
    <div class="pbar-track"></div>
    <div class="pbar-pin" style={`left:${pos}%`}></div>
    <div class="pbar-label" style={`left:${pos}%`}>{value.toFixed(0)}</div>
    {showTicks && (
      <div class="pbar-ticks">
        <span>0 便宜</span>
        <span>50</span>
        <span>100 贵</span>
      </div>
    )}
  </div>
)}
